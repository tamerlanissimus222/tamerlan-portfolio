---
import { profile } from '@/data/profile';
---

<section class="about" id="about" aria-labelledby="about-title" data-intro-transition>
  <div class="about__sticky section-shell">
    <div class="about__letterbox about__letterbox--top" aria-hidden="true"></div>
    <div class="about__letterbox about__letterbox--bottom" aria-hidden="true"></div>

    <div class="about__stage">
      <div class="about__metrics">
        <p class="about__technical-label"><span>02</span> / Practice data</p>
        <dl class="about__metric-grid">
          {profile.experienceMetrics.map((item, index) => (
            <div
              class:list={['about__metric', { 'about__metric--accent': item.accent }]}
              data-intro-metric
              style={`--metric-index: ${index}`}
            >
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <dt>{item.value}</dt>
              <dd>{item.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="about__introduction">
        <h2 class="about__technical-label" id="about-title">Introduction</h2>
        <p class="about__placeholder-label">[Introduction copy — to be added]</p>
        <p class="about__introduction-copy">{profile.introduction}</p>
      </div>
    </div>

    <div class="about__case-wipe" aria-hidden="true"></div>
  </div>
</section>
