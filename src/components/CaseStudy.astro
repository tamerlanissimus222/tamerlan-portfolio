---
import type { CollectionEntry } from 'astro:content';
import CaseContext from './CaseContext.astro';
import WorkflowBoard from './WorkflowBoard.astro';

interface Props {
  entry: CollectionEntry<'cases'>;
  active?: boolean;
}

const { entry, active = false } = Astro.props;
const { data } = entry;
const caseNumber = String(data.order).padStart(2, '0');
const caseId = `case-${caseNumber}`;
---

<article
  class="case-study"
  id={`case-panel-${caseNumber}`}
  role="tabpanel"
  aria-labelledby={`case-tab-${caseNumber}`}
  data-case-panel={caseNumber}
  hidden={!active}
>
  <div class="case-study__composition">
    <CaseContext data={data} caseId={caseId} caseNumber={caseNumber} />
    <WorkflowBoard
      caseId={caseId}
      stages={data.stages}
      validationStatus={data.validation.status}
    />
  </div>
</article>
