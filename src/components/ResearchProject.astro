---
import type { CollectionEntry } from 'astro:content';
import ImageGallery from './ImageGallery.astro';
import Model3DViewer from './Model3DViewer.astro';
import ResearchVideo from './ResearchVideo.astro';
import TagList from './TagList.astro';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { data } = entry;
const stages = [
  ['Problem', data.problem],
  ['Idea / hypothesis', data.hypothesis],
  ['Development', data.development],
  ['Result', data.result],
];
---

<article class="research-project" data-reveal>
  <div class="research-project__media" aria-label={`${data.title} media`}>
    {data.videos.length > 0 && (
      <div class="research-video-grid" style={`--research-video-count: ${data.videos.length}`}>
        {data.videos.map((video, index) => <ResearchVideo {...video} index={index + 1} />)}
      </div>
    )}
    {data.images.length > 0 && <ImageGallery images={data.images} label={`${data.title} research media`} compact />}
    {data.models.length > 0 && <div class="model-grid">{data.models.map((model, i) => <Model3DViewer {...model} index={i + 1} />)}</div>}
  </div>
  <div class="research-project__split-line" aria-hidden="true"></div>
  <div class="research-project__content">
    <header>
      <div>
        <h3 class="eyebrow research-project__name">{data.title}</h3>
      </div>
      <span class:list={['status-badge', `status-badge--${data.status.toLowerCase()}`]}>{data.status}</span>
    </header>
    {data.placeholder && <p class="placeholder-notice"><strong>Editorial checkpoint</strong> — replace bracketed claims with test evidence.</p>}
    <ol class="research-project__stages">
      {stages.map(([label, copy], index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h4>{label}</h4>
          <p>{copy}</p>
        </li>
      ))}
    </ol>
    <TagList tags={data.tags} label="Development project tags" />
  </div>
</article>

<style>
  .research-video-grid {
    --video-gap: clamp(0.8rem, 1.15vw, 1.2rem);
    display: grid;
    width: 100%;
    grid-template-columns: repeat(var(--research-video-count), minmax(0, 1fr));
    gap: var(--video-gap);
  }

  .research-video-grid :global(.research-video__poster) {
    height: clamp(13rem, 17vw, 16rem);
  }

  .research-project__content > header .research-project__name {
    max-width: none;
    margin-top: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.1em;
  }

  @media (max-width: 60rem) {
    .research-video-grid {
      grid-auto-columns: minmax(13.75rem, 42vw);
      grid-auto-flow: column;
      grid-template-columns: none;
      padding-bottom: 0.65rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-color: rgb(237 242 239 / 0.3) #0c120f;
      scrollbar-width: thin;
    }
  }

  @media (max-width: 40rem) {
    .research-video-grid {
      grid-auto-columns: minmax(15rem, 82vw);
      gap: 0.75rem;
    }
  }
</style>
