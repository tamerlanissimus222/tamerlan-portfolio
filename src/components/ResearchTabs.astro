---
import type { CollectionEntry } from 'astro:content';
import { researchTabs } from '@/data/research-tabs';
import ResearchProject from './ResearchProject.astro';
import ResearchGallery from './ResearchGallery.astro';
import ResearchArticle from './ResearchArticle.astro';

interface Props {
  entries: CollectionEntry<'research'>[];
}

const { entries } = Astro.props;
const tabs = researchTabs.map((tab) => {
  const entry = entries.find((project) => project.id === tab.projectId);
  if (tab.projectId && !entry) throw new Error(`Missing research project: ${tab.projectId}`);
  return { ...tab, entry };
});
---

<div class="research-tabs" data-research-tabs>
  <div class="research-tabs__strip" role="tablist" aria-label="Development projects">
    {tabs.map((tab, index) => (
      <button
        class="research-tabs__tab"
        type="button"
        role="tab"
        id={`research-tab-${tab.id}`}
        aria-controls={`research-panel-${tab.id}`}
        aria-selected={index === 0}
        tabindex={index === 0 ? 0 : -1}
      >
        {tab.label}
      </button>
    ))}
  </div>
  <div class="research-tabs__panels">
    {tabs.map((tab, index) => (
      <div
        class="research-tabs__panel"
        role="tabpanel"
        id={`research-panel-${tab.id}`}
        aria-labelledby={`research-tab-${tab.id}`}
        tabindex="0"
        hidden={index !== 0}
      >
        {tab.entry ? <ResearchProject entry={tab.entry} /> : tab.article ? (
          <ResearchArticle article={tab.article} />
        ) : tab.images?.length ? (
          <ResearchGallery id={tab.id} label={tab.label} images={tab.images} />
        ) : (
          <div class="research-tabs__empty">
            <h3>{tab.label}</h3>
            <p>Content to be added.</p>
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-research-tabs]').forEach((root) => {
    const strip = root.querySelector<HTMLElement>('[role="tablist"]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    if (!strip || !buttons.length) return;

    const activate = (selected: HTMLButtonElement) => {
      buttons.forEach((button) => {
        const active = button === selected;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        const active = panel.id === selected.getAttribute('aria-controls');
        panel.hidden = !active;
        if (active) {
          panel.querySelectorAll('[data-reveal]').forEach((item) => item.classList.add('is-visible'));
        }
      });

      // Reveal the selected tab horizontally without moving the page vertically.
      const bounds = strip.getBoundingClientRect();
      const tabBounds = selected.getBoundingClientRect();
      if (tabBounds.left < bounds.left) strip.scrollLeft -= bounds.left - tabBounds.left;
      else if (tabBounds.right > bounds.right) strip.scrollLeft += tabBounds.right - bounds.right;
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => activate(button));
      button.addEventListener('keydown', (event) => {
        let next: number;
        switch (event.key) {
          case 'ArrowRight': next = (index + 1) % buttons.length; break;
          case 'ArrowLeft': next = (index - 1 + buttons.length) % buttons.length; break;
          case 'Home': next = 0; break;
          case 'End': next = buttons.length - 1; break;
          default: return;
        }
        event.preventDefault();
        buttons[next].focus({ preventScroll: true });
        activate(buttons[next]);
      });
    });
  });
</script>

<style>
  .research-tabs { min-width: 0; }
  .research-tabs__strip {
    display: flex;
    gap: 0.3rem;
    overflow-x: auto;
    border-bottom: 1px solid rgb(194 231 151 / 0.28);
    scrollbar-width: thin;
    scrollbar-color: rgb(194 231 151 / 0.35) transparent;
  }
  .research-tabs__tab {
    position: relative;
    flex: 0 0 auto;
    min-width: 7.5rem;
    min-height: 3.25rem;
    padding: 0.85rem clamp(1rem, 2vw, 2rem);
    border: 1px solid rgb(237 242 239 / 0.14);
    border-bottom: 0;
    border-radius: 0.65rem 0.65rem 0 0;
    background: rgb(5 10 7 / 0.5);
    color: #aebbb3;
    font-family: var(--font-mono);
    font-size: clamp(0.875rem, 1.05vw, 1rem);
    font-weight: 500;
    line-height: 1.4;
    text-align: left;
    text-transform: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .research-tabs__tab:hover { color: #edf2ef; background: #17231c; }
  .research-tabs__tab[aria-selected="true"] {
    border-color: rgb(194 231 151 / 0.28);
    background: #1b2a21;
    color: #edf2ef;
    box-shadow: inset 0 2px var(--color-accent);
  }
  .research-tabs__tab:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -5px;
  }
  .research-tabs__panels {
    min-height: clamp(28rem, 65svh, 44rem);
    padding-top: clamp(1.5rem, 2.5vw, 2.75rem);
  }
  .research-tabs__panel { min-width: 0; }
  .research-tabs__panel[hidden] { display: none; }
  .research-tabs__panel:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 0.5rem; }
  .research-tabs__empty {
    padding: clamp(3rem, 6vw, 6rem) 0;
  }
  .research-tabs__empty h3 {
    color: #edf2ef;
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 500;
  }
  .research-tabs__empty p { margin-top: 0.8rem; color: #aebbb3; font-size: 1rem; }
  @media (max-width: 40rem) {
    .research-tabs__tab { min-width: auto; padding-inline: 1rem; }
    .research-tabs__panels { min-height: 26rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .research-tabs__tab { transition: none; }
  }
</style>
