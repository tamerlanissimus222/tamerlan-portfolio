---
import { getCollection } from 'astro:content';
import About from '@/components/About.astro';
import ArchiveGrid from '@/components/ArchiveGrid.astro';
import CaseStudy from '@/components/CaseStudy.astro';
import CaseNavigation from '@/components/CaseNavigation.astro';
import ChapterDivider from '@/components/ChapterDivider.astro';
import FooterLab from '@/components/FooterLab.astro';
import Hero from '@/components/Hero.astro';
import MediaLightbox from '@/components/MediaLightbox.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ResearchProject from '@/components/ResearchProject.astro';
import Workflow from '@/components/Workflow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const otherWork = (await getCollection('other-work')).sort((a, b) => a.data.order - b.data.order);

---

<BaseLayout
  title="Tamerlan Khunaev — Digital Prosthetics & R&D Engineer"
  description="Portfolio of Tamerlan Khunaev: digital prosthetics, scan-to-CAD workflows, upper-limb socket development, additive manufacturing and R&D."
>
  <Hero />
  <main id="main-content">
    <ChapterDivider sectionId="about" index="02" label="Practice data" />
    <About />

    <ChapterDivider sectionId="cases" index="03" label="Selected prosthetic cases" labelId="cases-title" />
    <section class="cases" id="cases" aria-labelledby="cases-title" data-case-section>
      <span class="section-scroll-anchor" data-section-anchor aria-hidden="true"></span>
      <header class="case-section__header case-section__header--navigation-only">
        <CaseNavigation cases={cases} />
      </header>
      <div class="case-list" data-case-list>
        {cases.map((entry, index) => <CaseStudy entry={entry} active={index === 0} />)}
      </div>
      <MediaLightbox />
    </section>

    <ChapterDivider sectionId="workflow" label="Digital workflow" />
    <Workflow />

    <ChapterDivider sectionId="research" index="04" label="Developments & experiments" labelId="research-title" />
    <section
      class="research section-shell"
      id="research"
      aria-labelledby="research-title"
      style={`--research-blueprint: url("${withBase('media/da-vinci-blueprint.svg')}")`}
    >
      <div class="research-list">
        {research.map((entry) => <ResearchProject entry={entry} />)}
      </div>
      <section class="archive" aria-labelledby="archive-title">
        <header data-reveal>
          <div>
            <p class="eyebrow">Experimental archive</p>
            <h3 id="archive-title">Small trials. Useful signals.</h3>
          </div>
          <p data-filter-ready>Structured with category data for future filters.</p>
        </header>
        <ArchiveGrid />
      </section>
    </section>

    <ChapterDivider sectionId="other-work" index="05" label="Other work" labelId="other-work-title" />
    <section class="other-work section-shell" id="other-work" aria-labelledby="other-work-title">
      <header class="section-header section-header--content-only" data-reveal>
        <div>
          <h2>Engineering range beyond prosthetics.</h2>
          <p class="section-intro">The source portfolio contained no verified non-prosthetic project media, so these cards are intentionally publication-ready placeholders.</p>
        </div>
      </header>
      <div class="project-grid">
        {otherWork.map((entry) => <ProjectCard entry={entry} />)}
      </div>
    </section>
  </main>
  <FooterLab />
  <script>
    import '../scripts/cases.ts';
  </script>
</BaseLayout>
